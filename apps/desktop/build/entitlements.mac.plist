<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 JIT, for the app and for the core (Electron run as Node) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- the core loads node-pty's native module -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- shells and agents in panes inherit the core's environment -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Visualizer windows can listen to the microphone (renderer/src/audio.ts) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

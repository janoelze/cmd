# Served by Apache on Uberspace (scripts/deploy-remote.sh). Every path that
# isn't a file is the app (/pair#… included), and the page is locked down: its
# own scripts only, WebSockets to relays only, never framed, no referrer.
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]

Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src wss:; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
Header always set Referrer-Policy "no-referrer"
Header always set X-Content-Type-Options "nosniff"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

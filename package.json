{
  "name": "cmd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "core": "node --no-warnings packages/core/src/main.ts --instance=dev",
    "core:stop": "node scripts/stop-core.mjs",
    "core:stop-all": "node scripts/stop-core.mjs --all",
    "cmd": "node --no-warnings packages/cli/src/main.ts",
    "relay": "node --no-warnings apps/relay/src/main.ts",
    "web": "pnpm --filter @cmd/web dev",
    "ui": "pnpm --filter @cmd/ui gallery",
    "workbench": "node scripts/workbench.mjs",
    "remote:device": "node --no-warnings packages/cli/src/remote-device.ts",
    "dev": "pnpm --filter @cmd/desktop dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @cmd/ui typecheck && pnpm --filter @cmd/desktop typecheck && pnpm --filter @cmd/web typecheck",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "pnpm --filter @cmd/desktop build",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "pnpm build && node e2e/smoke.mjs",
    "e2e:drops": "pnpm build && node e2e/drops.mjs",
    "e2e:remote": "pnpm build && node --no-warnings e2e/remote.mjs",
    "e2e:web": "node --no-warnings e2e/web.mjs",
    "dist": "pnpm build && node scripts/stage-runtime.mjs && pnpm --filter @cmd/desktop dist",
    "release": "node scripts/release.mjs",
    "shots": "pnpm build && node scripts/readme-shots/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}

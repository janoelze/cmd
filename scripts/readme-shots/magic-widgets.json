  "html": "<style>.sum{gap:14px;padding-bottom:6px;border-bottom:1px solid var(--line)}.run{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}.run:last-child{border-bottom:0}.run a{color:var(--text);text-decoration:none}.run a:hover{color:var(--accent)}.meta{gap:6px}.r{text-align:right}</style>\n<div class=\"k-stack k-fill\">\n  <div class=\"k-row sum k-small\" id=\"sum\"></div>\n  <div id=\"list\" style=\"overflow:auto;flex:1\"></div>\n</div>\n<script>\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nfunction st(r){\n  if(r.status!==\"completed\")return{cls:\"k-warn\",word:r.status===\"in_progress\"?\"Running\":r.status[0].toUpperCase()+r.status.slice(1).replace(\"_\",\" \")};\n  const c=r.conclusion;\n  if(c===\"success\")return{cls:\"k-good\",word:\"Success\"};\n  if(c===\"failure\"||c===\"timed_out\"||c===\"startup_failure\")return{cls:\"k-bad\",word:\"Failed\"};\n  return{cls:\"\",word:c?c[0].toUpperCase()+c.slice(1).replace(\"_\",\" \"):\"–\"};\n}\ncmd.onData(d=>{\n  if(!Array.isArray(d)){list.innerHTML='<div class=\"k-empty\">Couldn’t read runs. Try <span class=\"k-mono\">gh auth login</span>.</div>';sum.textContent=\"\";return;}\n  if(!d.length){list.innerHTML='<div class=\"k-empty\">No workflow runs yet</div>';sum.textContent=\"\";return;}\n  const n={run:0,ok:0,bad:0};\n  d.forEach(r=>{const s=st(r);if(s.cls===\"k-warn\")n.run++;else if(s.cls===\"k-good\")n.ok++;else if(s.cls===\"k-bad\")n.bad++;});\n  sum.innerHTML=`<span class=\"k-row\" style=\"gap:5px\"><span class=\"k-dot ${n.run?\"k-warn\":\"\"}\"></span>${n.run} running</span><span class=\"k-row\" style=\"gap:5px\"><span class=\"k-dot k-good\"></span>${n.ok} passed</span><span class=\"k-row\" style=\"gap:5px\"><span class=\"k-dot ${n.bad?\"k-bad\":\"\"}\"></span>${n.bad} failed</span><span class=\"k-spacer\"></span><span class=\"k-dim\">last ${d.length} runs</span>`;\n  list.replaceChildren(...d.map(r=>{\n    const s=st(r),e=document.createElement(\"div\");e.className=\"run\";\n    const end=r.status===\"completed\"?new Date(r.updatedAt):new Date();\n    const dur=Math.max(0,(end-new Date(r.createdAt))/1000);\n    e.innerHTML=`<span class=\"k-dot ${s.cls}\" title=\"${s.word}\"></span>\n      <div class=\"k-stack\" style=\"gap:1px;min-width:0\"><a class=\"k-ellipsis\" href=\"${esc(r.url)}\" target=\"_blank\">${esc(r.displayTitle)}</a>\n      <div class=\"k-row meta k-small k-dim\"><span class=\"k-mono\">${esc(r.name)}</span><span>·</span><span class=\"k-mono k-ellipsis\">${esc(r.headBranch)}</span><span>·</span><span>${esc(r.event)}</span></div></div>\n      <div class=\"k-stack r\" style=\"gap:1px\"><span class=\"k-small ${s.cls}\">${s.word}</span><span class=\"k-small k-dim k-mono\">${cmd.fmt.dur(Math.round(dur))} · ${cmd.fmt.ago(r.createdAt)}</span></div>`;\n    return e;\n  }));\n});\n</script>",

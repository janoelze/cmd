  },
  "refresh": 900,
  "html": "<style>.now{align-items:flex-end;gap:12px}.t{font-size:clamp(28px,14vmin,52px);line-height:1;font-variant-numeric:tabular-nums}.days{display:grid;grid-template-columns:minmax(40px,auto) minmax(0,1fr) auto minmax(40px,2fr) auto auto;gap:4px 10px;align-items:center}.days>*{min-width:0}.rng{position:relative;height:4px;background:var(--fill);border-radius:2px}.rng i{position:absolute;top:0;bottom:0;background:var(--c1);border-radius:2px}.rain{color:var(--c5)}@media (max-width:360px){.cond,.rainc{display:none}.days{grid-template-columns:auto auto minmax(30px,1fr) auto}}</style>\n<div class=\"k-stack k-fill\">\n  <div class=\"k-row now\"><div class=\"t k-mono\" id=\"t\">–</div><div class=\"k-stack\" style=\"gap:2px;min-width:0\"><div class=\"k-ellipsis\" id=\"w\"></div><div class=\"k-dim k-small k-ellipsis\" id=\"f\"></div></div></div>\n  <div class=\"k-spacer\"></div>\n  <div class=\"days k-hide-short\" id=\"days\"></div>\n</div>\n<script>\nconst W={0:\"Clear\",1:\"Mostly clear\",2:\"Partly cloudy\",3:\"Overcast\",45:\"Fog\",48:\"Fog\",51:\"Light drizzle\",53:\"Drizzle\",55:\"Heavy drizzle\",56:\"Freezing drizzle\",57:\"Freezing drizzle\",61:\"Light rain\",63:\"Rain\",65:\"Heavy rain\",66:\"Freezing rain\",67:\"Freezing rain\",71:\"Light snow\",73:\"Snow\",75:\"Heavy snow\",77:\"Snow grains\",80:\"Showers\",81:\"Showers\",82:\"Heavy showers\",85:\"Snow showers\",86:\"Snow showers\",95:\"Thunderstorm\",96:\"Thunderstorm\",99:\"Thunderstorm\"};\nconst r=n=>n==null?\"–\":Math.round(n)+\"°\";\ncmd.onData(d=>{\n  if(!d||!d.current){t.textContent=\"–\";w.textContent=\"Forecast unavailable\";return;}\n  const c=d.current,dl=d.daily;\n  t.textContent=r(c.temperature_2m);\n  w.textContent=W[c.weather_code]??\"\";\n  f.textContent=`Feels ${r(c.apparent_temperature)} · ${Math.round(c.relative_humidity_2m)}% humidity · wind ${Math.round(c.wind_speed_10m)} km/h`;\n  const lo=Math.min(...dl.temperature_2m_min),hi=Math.max(...dl.temperature_2m_max),span=Math.max(1,hi-lo);\n  const out=[];\n  dl.time.forEach((day,i)=>{\n    const name=i?new Date(day+\"T00:00:00Z\").toLocaleDateString(undefined,{weekday:\"short\",timeZone:\"UTC\"}):\"Today\";\n    const mn=dl.temperature_2m_min[i],mx=dl.temperature_2m_max[i],p=dl.precipitation_probability_max[i];\n    const a=(mn-lo)/span*100,b=(mx-lo)/span*100;\n    out.push(\n      `<div class=\"${i?\"\":\"k-dim\"}\">${name}</div>`,\n      `<div class=\"cond k-dim k-ellipsis k-small\">${W[dl.weather_code[i]]??\"\"}</div>`,\n      `<div class=\"k-num k-mono k-dim\">${r(mn)}</div>`,\n      `<div class=\"rng\"><i style=\"left:${a}%;width:${Math.max(2,b-a)}%\"></i></div>`,\n      `<div class=\"k-num k-mono\">${r(mx)}</div>`,\n      `<div class=\"rainc k-num k-mono k-small ${p>=30?\"rain\":\"k-dim\"}\">${p==null?\"–\":p+\"%\"}</div>`\n    );\n  });\n  days.innerHTML=out.join(\"\");\n});\n</script>",

  "html": "<style>.head{gap:10px;align-items:center}.head .k-big{font-size:clamp(18px,7vmin,28px)}.runs{overflow:auto;flex:1;min-height:0}.runs td{vertical-align:middle}.msg{max-width:0;width:100%}.dur{white-space:nowrap}@media (max-width:420px){.c-branch,.c-ago{display:none}}</style>\n<div class=\"k-stack k-fill\">\n  <div class=\"k-row head\">\n    <span class=\"k-dot\" id=\"hdot\"></span>\n    <div class=\"k-stack\" style=\"gap:0;min-width:0;flex:1\">\n      <div class=\"k-big\" id=\"hstate\">–</div>\n      <div class=\"k-dim k-small k-ellipsis\" id=\"hsub\"></div>\n    </div>\n    <div class=\"k-stack k-hide-narrow\" style=\"gap:0;text-align:right\">\n      <div class=\"k-title\">Last 20</div>\n      <div class=\"k-small k-mono\" id=\"tally\"></div>\n    </div>\n  </div>\n  <div class=\"runs k-hide-short\"><table class=\"k-table\"><tbody id=\"rows\"></tbody></table></div>\n</div>\n<script>\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst st=r=>{\n  if(r.status!==\"completed\")return{cls:\"k-warn\",word:r.status===\"in_progress\"?\"Running\":r.status===\"queued\"?\"Queued\":r.status.replace(/_/g,\" \")};\n  const c=r.conclusion;\n  if(c===\"success\")return{cls:\"k-good\",word:\"Passed\"};\n  if(c===\"failure\"||c===\"timed_out\"||c===\"startup_failure\")return{cls:\"k-bad\",word:c===\"failure\"?\"Failed\":c.replace(/_/g,\" \")};\n  return{cls:\"\",word:c?c[0].toUpperCase()+c.slice(1).replace(/_/g,\" \"):\"–\"};\n};\nconst dur=r=>{const a=new Date(r.createdAt),b=r.status===\"completed\"?new Date(r.updatedAt):new Date();return cmd.fmt.dur(Math.max(0,Math.round((b-a)/1000)));};\ncmd.onData(d=>{\n  if(!Array.isArray(d)){hstate.textContent=\"Can't read runs\";hsub.textContent=typeof d===\"string\"?d.split(\"\\n\")[0]:\"Try gh auth login\";rows.replaceChildren();return;}\n  if(!d.length){hstate.textContent=\"No runs yet\";hsub.textContent=\"janoelze/cmd\";rows.replaceChildren();return;}\n  const live=d.filter(r=>r.status!==\"completed\");\n  const top=live[0]||d[0],s=st(top);\n  hdot.className=\"k-dot \"+s.cls;\n  hstate.textContent=live.length>1?`${live.length} running`:s.word;\n  hsub.textContent=`${top.name} · ${top.headBranch} · ${top.displayTitle}`;\n  const n=k=>d.filter(r=>st(r).cls===k).length;\n  tally.innerHTML=`<span class=\"k-good\">${n(\"k-good\")}✓</span> <span class=\"k-bad\">${n(\"k-bad\")}✗</span> <span class=\"k-warn\">${n(\"k-warn\")}●</span>`;\n  rows.replaceChildren(...d.map(r=>{\n    const s=st(r),tr=document.createElement(\"tr\");\n    tr.innerHTML=`<td style=\"width:1%\"><span class=\"k-dot ${s.cls}\" title=\"${esc(s.word)}\"></span></td><td class=\"k-text msg\"><div class=\"k-ellipsis\">${esc(r.displayTitle)}</div><div class=\"k-dim k-small k-ellipsis\">${esc(r.name)} · ${esc(r.event)}</div></td><td class=\"k-dim k-small c-branch k-ellipsis\" style=\"max-width:110px\">${esc(r.headBranch)}</td><td class=\"k-num dur ${s.cls===\"k-warn\"?\"k-warn\":\"\"}\">${dur(r)}</td><td class=\"k-num k-dim k-small c-ago dur\">${cmd.fmt.ago(r.createdAt)}</td>`;\n    tr.style.cursor=\"pointer\";tr.onclick=()=>window.open(r.url,\"_blank\");\n    return tr;\n  }));\n});\n</script>",

 {
  "prompt": "how full is my disk",
  "title": "Disk space",
  "size": "s",
  "source": {
   "type": "command",
   "command": "df -k /System/Volumes/Data | awk 'NR==2{printf \"{\\\"total\\\":%d,\\\"used\\\":%d,\\\"avail\\\":%d}\", $2*1024,$3*1024,$4*1024}'"
  },
  "refresh": 60,
  "html": "<style>.pct{font-size:clamp(28px,16vmin,56px);line-height:1}.bar{height:8px}.bar i{height:100%}</style>\n<div class=\"k-stack k-fill\">\n  <div class=\"k-row k-between\"><div class=\"k-title\">Macintosh HD</div><div class=\"k-small\" id=\"st\"></div></div>\n  <div class=\"k-row\" style=\"align-items:baseline;gap:8px\"><div class=\"pct k-mono\" id=\"pct\">–</div><div class=\"k-dim\">full</div></div>\n  <div class=\"k-bar bar\"><i id=\"fill\" style=\"--v:0%\"></i></div>\n  <div class=\"k-spacer\"></div>\n  <div class=\"k-row k-between k-small k-hide-short\">\n    <div><span class=\"k-mono\" id=\"free\">–</span> <span class=\"k-dim\">free</span></div>\n    <div><span class=\"k-mono\" id=\"used\">–</span> <span class=\"k-dim\">used of</span> <span class=\"k-mono\" id=\"tot\">–</span></div>\n  </div>\n</div>\n<script>\ncmd.onData(d=>{\n  if(!d||!d.total){pct.textContent=\"–\";st.textContent=\"Couldn't read disk\";return;}\n  const usedAll=d.total-d.avail,p=usedAll/d.total*100;\n  const col=p>=95?\"var(--bad)\":p>=85?\"var(--warn)\":\"var(--good)\";\n  pct.innerHTML=Math.round(p)+'<span class=\"k-unit\">%</span>';\n  fill.style.setProperty(\"--v\",p.toFixed(1)+\"%\");fill.style.setProperty(\"--c\",col);\n  st.innerHTML=`<span class=\"k-dot ${p>=95?\"k-bad\":p>=85?\"k-warn\":\"k-good\"}\"></span> ${p>=95?\"Almost full\":p>=85?\"Getting full\":\"OK\"}`;\n  free.textContent=cmd.fmt.bytes(d.avail);\n  used.textContent=cmd.fmt.bytes(usedAll);\n  tot.textContent=cmd.fmt.bytes(d.total);\n});\n</script>",
  "data": {
   "total": 994610155520,
   "used": 885031563264,
   "avail": 84026032128
  }

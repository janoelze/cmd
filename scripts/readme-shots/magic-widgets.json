  "refresh": 3600,
  "html": "<style>.head{align-items:flex-end;gap:16px;flex-wrap:wrap}.head>div{min-width:0}</style>\n<div class=\"k-stack k-fill\">\n  <div class=\"k-row head\">\n    <div class=\"k-stat\"><div class=\"k-stat-label\" id=\"lbl\">1 EUR</div><div class=\"k-stat-value\" id=\"now\" style=\"font-size:clamp(20px,10vmin,40px)\">–</div><div class=\"k-delta\" id=\"chg\"></div></div>\n    <div class=\"k-stat k-hide-narrow\"><div class=\"k-stat-label\">30-day range</div><div class=\"k-stat-value k-dim\" id=\"range\" style=\"font-size:15px\">–</div><div class=\"k-stat-note\" id=\"avg\"></div></div>\n  </div>\n  <div class=\"k-chart k-hide-short\" id=\"chart\" style=\"flex:1;min-height:60px\"></div>\n  <div class=\"k-dim k-small k-ellipsis\" id=\"note\"></div>\n</div>\n<script>\nconst f=n=>cmd.fmt.num(n,2);\ncmd.onData(d=>{\n  if(!d||!d.rates){now.textContent=\"–\";note.textContent=\"Couldn't load rates.\";return;}\n  const end=new Date(d.end_date+\"T00:00:00Z\"),cut=new Date(end-30*864e5).toISOString().slice(0,10);\n  const days=Object.keys(d.rates).sort().filter(k=>k>=cut);\n  const v=days.map(k=>d.rates[k].JPY);\n  if(!v.length){now.textContent=\"–\";return;}\n  const first=v[0],last=v.at(-1),pct=(last-first)/first*100,diff=last-first;\n  now.innerHTML=`${f(last)}<span class=\"k-unit\">JPY</span>`;\n  chg.className=\"k-delta \"+(pct>=0?\"k-up\":\"k-down\");\n  chg.textContent=`${pct>=0?\"▲\":\"▼\"} ${f(Math.abs(diff))} · ${cmd.fmt.pct(Math.abs(pct))} in 30 days`;\n  range.textContent=`${f(Math.min(...v))} – ${f(Math.max(...v))}`;\n  avg.textContent=`Avg ${f(v.reduce((a,b)=>a+b,0)/v.length)}`;\n  lbl.textContent=`1 EUR · ${cmd.fmt.date(d.end_date)}`;\n  note.textContent=`ECB reference rates, working days · ${cmd.fmt.date(days[0])} – ${cmd.fmt.date(days.at(-1))}`;\n  cmd.chart(chart,{type:\"line\",area:true,labels:days.map(k=>cmd.fmt.date(k)),series:[{name:\"JPY\",values:v}],format:f});\n});\n</script>",

  "refresh": 3600,
  "html": "<div class=\"k-stack k-fill\">\n  <div class=\"k-grid\">\n    <div class=\"k-stat\"><div class=\"k-stat-label\">1 EUR</div><div class=\"k-stat-value\" id=\"now\">–</div><div class=\"k-delta\" id=\"chg\"></div></div>\n    <div class=\"k-stat\"><div class=\"k-stat-label\">30-day range</div><div class=\"k-stat-value k-dim\" id=\"range\" style=\"font-size:15px\">–</div><div class=\"k-stat-note k-dim\" id=\"asof\"></div></div>\n  </div>\n  <div class=\"k-chart\" id=\"chart\" style=\"flex:1\"></div>\n</div>\n<script>\nconst f=n=>cmd.fmt.num(n,2);\ncmd.onData(d=>{\n  if(!d||!d.rates){now.textContent=\"–\";asof.textContent=\"Couldn't load rates\";return;}\n  let days=Object.keys(d.rates).sort();\n  const last=new Date(days.at(-1)),cut=new Date(last.getTime()-30*864e5).toISOString().slice(0,10);\n  days=days.filter(x=>x>=cut);\n  const v=days.map(x=>d.rates[x].JPY),a=v[0],b=v.at(-1),pct=(b-a)/a*100;\n  now.innerHTML=`${f(b)}<span class=\"k-unit\">JPY</span>`;\n  chg.className=\"k-delta \"+(pct>=0?\"k-up\":\"k-down\");\n  chg.textContent=`${pct>=0?\"▲\":\"▼\"} ${cmd.fmt.pct(Math.abs(pct))} over 30 days`;\n  range.textContent=`${f(Math.min(...v))} – ${f(Math.max(...v))}`;\n  asof.textContent=`ECB reference rate · ${cmd.fmt.date(days.at(-1))}`;\n  cmd.chart(chart,{type:\"line\",area:true,labels:days.map(x=>cmd.fmt.date(x)),series:[{name:\"JPY\",values:v}],format:f});\n});\n</script>",

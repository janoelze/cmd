 {
  "prompt": "how full is my disk",
  "title": "Disk space",
  "size": "s",
  "source": {
   "type": "command",
   "command": "df -k /System/Volumes/Data | tail -1 | awk '{print \"{\\\"total\\\":\"$2*1024\",\\\"used\\\":\"$3*1024\",\\\"avail\\\":\"$4*1024\"}\"}'"
  },
  "refresh": 60,
  "html": "<style>.big{align-items:baseline;gap:8px}.bar{height:8px}</style>\n<div class=\"k-stack k-fill\" style=\"justify-content:center\">\n  <div class=\"k-between k-row\"><div class=\"k-title\">Macintosh HD</div><div class=\"k-row k-small\" style=\"gap:6px\"><span class=\"k-dot\" id=\"dot\"></span><span id=\"st\">–</span></div></div>\n  <div class=\"k-row big\"><div class=\"k-huge k-mono\" id=\"pct\">–</div><div class=\"k-dim\">full</div></div>\n  <div class=\"k-bar bar\"><i id=\"fill\" style=\"--v:0%\"></i></div>\n  <div class=\"k-between k-row k-small\"><span><span class=\"k-mono\" id=\"used\">–</span> <span class=\"k-dim\">used</span></span><span><span class=\"k-mono\" id=\"free\">–</span> <span class=\"k-dim\">free of</span> <span class=\"k-mono\" id=\"tot\">–</span></span></div>\n</div>\n<script>\ncmd.onData(d=>{\n  if(!d||!d.total){st.textContent=\"Couldn't read disk usage\";return;}\n  const used=d.total-d.avail,p=used/d.total*100;\n  const lvl=p>=95?\"bad\":p>=85?\"warn\":\"good\";\n  pct.textContent=Math.round(p)+\"%\";\n  fill.style.setProperty(\"--v\",p.toFixed(1)+\"%\");\n  fill.style.setProperty(\"--c\",`var(--${lvl===\"good\"?\"c1\":lvl})`);\n  dot.className=\"k-dot k-\"+lvl;\n  st.textContent=lvl===\"bad\"?\"Almost full\":lvl===\"warn\"?\"Getting full\":\"Plenty of space\";\n  used.textContent=cmd.fmt.bytes(used);\n  free.textContent=cmd.fmt.bytes(d.avail);\n  tot.textContent=cmd.fmt.bytes(d.total);\n});\n</script>",
  "data": {
   "total": 994610155520,

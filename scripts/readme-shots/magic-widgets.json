 {
  "prompt": "a 5 minute tea timer",
  "title": "Tea timer",
  "size": "s",
  "source": null,
  "refresh": 0,
  "html": "<style>.clock{font-size:clamp(28px,22vmin,72px);font-variant-numeric:tabular-nums;line-height:1}.prog{width:min(260px,80%)}</style>\n<div class=\"k-stack k-center k-fill\">\n  <div class=\"k-mono clock\" id=\"clock\">5:00</div>\n  <div class=\"k-row k-hide-short\" style=\"gap:6px\"><span class=\"k-dot\" id=\"dot\"></span><span class=\"k-dim\" id=\"phase\">Ready</span></div>\n  <div class=\"k-bar prog k-hide-short\"><i id=\"bar\" style=\"--v:0%\"></i></div>\n  <div class=\"k-row\"><button class=\"k-btn k-primary\" id=\"go\">Start</button><button class=\"k-btn\" id=\"reset\">Reset</button></div>\n</div>\n<script>\nconst LEN=5*60;\nlet s=cmd.state.get(\"tea\")||{left:LEN,end:null};\nconst save=()=>cmd.state.set(\"tea\",s);\nlet beeped=false;\nfunction beep(){try{const a=new (window.AudioContext||window.webkitAudioContext)();[0,0.35,0.7].forEach(t=>{const o=a.createOscillator(),g=a.createGain();o.frequency.value=880;g.gain.setValueAtTime(0.15,a.currentTime+t);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+t+0.3);o.connect(g);g.connect(a.destination);o.start(a.currentTime+t);o.stop(a.currentTime+t+0.3);});}catch(e){}}\nfunction tick(){\n  if(s.end){s.left=Math.max(0,Math.ceil((s.end-Date.now())/1000));if(!s.left){s.end=null;s.done=true;save();if(!beeped){beeped=true;beep();}}}\n  clock.textContent=Math.floor(s.left/60)+\":\"+String(s.left%60).padStart(2,\"0\");\n  const done=s.done&&!s.left;\n  phase.textContent=done?\"Tea's ready\":s.end?\"Steeping\":s.left<LEN?\"Paused\":\"Ready\";\n  dot.className=\"k-dot \"+(done?\"k-good\":s.end?\"k-warn\":\"\");\n  clock.className=\"k-mono clock\"+(done?\" k-good\":\"\");\n  bar.style.setProperty(\"--v\",((LEN-s.left)/LEN*100)+\"%\");\n  bar.style.setProperty(\"--c\",done?\"var(--good)\":\"var(--accent)\");\n  go.textContent=s.end?\"Pause\":done?\"Again\":s.left<LEN?\"Resume\":\"Start\";\n}\ngo.onclick=()=>{if(s.done&&!s.left){s={left:LEN,end:null};}s.done=false;beeped=false;s.end=s.end?null:Date.now()+s.left*1000;save();tick();};\nreset.onclick=()=>{s={left:LEN,end:null};beeped=false;save();tick();};\nsetInterval(tick,250);tick();\n</script>",
  "data": null
 }

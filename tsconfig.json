{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tools/*/src/**/*.ts",
    "tools/*/test/**/*.ts",
    "tools/tours/tours/**/*.ts",
    "apps/relay/src/**/*.ts",
    "apps/relay/test/**/*.ts",
    "test/**/*.ts"
  ],
  // Example widgets are Deno code (deno check covers them: cmd widget check).
  // @cmd/ui and @cmd/widget-api are React (TSX) with their own tsconfigs (pnpm --filter … typecheck).
  "exclude": ["packages/core/src/magic/prompt/examples/**", "packages/ui/**", "packages/widget-api/**"]
}

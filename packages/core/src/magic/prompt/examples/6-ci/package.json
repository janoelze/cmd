{
  "name": "ci-acme-shop",
  "version": "1.0.0",
  "description": "The latest GitHub Actions runs of a repository.",
  "type": "module",
  "devDependencies": { "@cmd/widget-api": "^1.0.0" },
  "cmd": {
    "api": 1,
    "widgets": [
      {
        "id": "ci",
        "title": "CI · acme/shop",
        "icon": "checkmark.seal",
        "main": "src/ci.tsx",
        "size": "m",
        "config": [
          { "key": "repo", "title": "Repository (owner/name)", "type": "string", "default": "acme/shop" },
          { "key": "token", "title": "GitHub token", "type": "string", "secret": true, "host": "api.github.com", "description": "Optional: private repositories and a higher rate limit." }
        ]
      }
    ],
    "permissions": { "net": ["api.github.com"] }
  }
}

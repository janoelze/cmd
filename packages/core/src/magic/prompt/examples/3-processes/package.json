{
  "name": "cpu-processes",
  "version": "1.0.0",
  "description": "The processes using the most CPU right now.",
  "type": "module",
  "devDependencies": { "@cmd/widget-api": "^1.1.0" },
  "cmd": {
    "api": 1,
    "widgets": [{ "id": "processes", "title": "CPU", "icon": "cpu", "main": "src/processes.tsx", "size": "m" }],
    "permissions": { "run": ["ps"], "act": ["terminals.open"] }
  }
}

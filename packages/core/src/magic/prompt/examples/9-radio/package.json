{
  "name": "bassdrive",
  "version": "1.0.0",
  "description": "Bassdrive, 24/7 drum and bass radio, with a level meter.",
  "type": "module",
  "devDependencies": { "@cmd/widget-api": "^1.0.0" },
  "cmd": {
    "api": 1,

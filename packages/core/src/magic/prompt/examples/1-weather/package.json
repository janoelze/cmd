{
  "name": "weather-lisbon",
  "version": "1.0.0",
  "description": "The weather now, the next hours and the days ahead, from Open-Meteo.",
  "type": "module",
  "devDependencies": { "@cmd/widget-api": "^1.0.0" },
  "cmd": {
    "api": 1,
    "widgets": [
      {
        "id": "weather",
        "title": "Weather · Lisbon",
        "icon": "cloud.sun",
        "main": "src/weather.tsx",
        "size": "m",
        "config": [{ "key": "city", "title": "City", "type": "string", "default": "Lisbon" }]
      }
    ],
    "permissions": { "net": ["geocoding-api.open-meteo.com", "api.open-meteo.com"] }
  }
}

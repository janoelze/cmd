{
  "name": "timer",
  "version": "1.1.0",
  "description": "A countdown that tells you when it's done, in any workspace.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "cmd": ">=0.30" },
  "files": ["src/timer.tsx", "src/timer.test.tsx", "src/timer.story.tsx", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cmd/widget-api": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.3.0"
  },
  "cmd": {
    "api": 1,
    "widgets": [
      {
        "id": "timer",
        "title": "Countdown",
        "icon": "timer",
        "description": "A countdown that tells you when it's done, in any workspace.",
        "main": "src/timer.tsx",
        "size": "s"
      }
    ],
    "permissions": {}
  }
}

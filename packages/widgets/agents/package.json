{
  "name": "agents",
  "version": "1.0.0",
  "description": "Every agent at a glance: who waits for you, who is working, what just finished.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "cmd": ">=0.30" },

{
  "name": "__NAME__",
  "version": "0.1.0",
  "description": "The terminals of this workspace, the busy ones first.",
  "license": "MIT",
  "type": "module",
  "engines": { "cmd": ">=__CMD__" },
  "files": ["src/__ID__.tsx", "README.md", "LICENSE"],
  "scripts": {
    "test": "vitest run",
    "check": "cmd widget check",
    "dev": "cmd widget dev"
  },
  "devDependencies": {
    "@cmd/widget-api": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "cmd": {
    "api": 1,
    "widgets": [
      {
        "id": "__ID__",
        "title": "__TITLE__",
        "icon": "terminal",
        "description": "The terminals of this workspace, the busy ones first.",
        "main": "src/__ID__.tsx",
        "size": "m",
        "config": [{ "key": "showFolders", "title": "Show Folders", "type": "boolean", "default": true, "description": "Each terminal's folder beside its title." }]
      }
    ],
    "permissions": { "workspace": ["read"] }
  }
}

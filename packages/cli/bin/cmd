#!/bin/sh
# Resolve symlinks so `cmd` can be linked onto PATH.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
exec node --no-warnings "$(cd "$(dirname "$self")/.." && pwd)/src/main.ts" "$@"
